#Generate fake dataset
	1) Generate organization id: ckan -c /etc/ckan/default/ckan.ini generate fake-data organization
	2) jq .id -r; get owner id from running step 1; or owner_org=$(ckan generate fake-data organization | jq .id -r)
	3) Generate dataset: ckan generate fake-data dataset --owner_org=$owner_org

